[
  {"name": "get_app_state", "arguments": {"app": "Calculator", "disable_diff": true}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] Button[^\\n]*id=AllClear", "var": "clear"}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] Button[^\\n]*id=Two", "var": "two"}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] Button[^\\n]*id=Add", "var": "add"}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] Button[^\\n]*id=Three", "var": "three"}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] Button[^\\n]*id=Equals", "var": "equals"}},
  {"name": "batch", "arguments": {"app": "Calculator", "actions": [
    {"tool": "click", "element_index": "$clear"},
    {"tool": "click", "element_index": "$two"},
    {"tool": "click", "element_index": "$add"},
    {"tool": "click", "element_index": "$three"},
    {"tool": "click", "element_index": "$equals"}]}},
  {"name": "get_app_state", "arguments": {"app": "Calculator", "disable_diff": true}},
  {"name": "@capture", "arguments": {"pattern": "StaticText value=\"([^\"]*)\" desc=\"Edit field\"", "var": "display"}},
  {"name": "@expect", "arguments": {"var": "display", "value": "5"}},
  {"name": "@absent", "arguments": {"pattern": "\\[frontmost\\]"}}
]
